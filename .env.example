# flight-info-mcp - local environment template
#
# Copy to ".env" (which is gitignored) and fill in your values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# The server loads .env at startup via python-dotenv. In production
# (containerized deploy) the orchestrator's injected env vars take
# precedence; .env is for local development and the Step 8 smoke run.

# ---- Required ----
# Aviationstack API key - sign up at https://aviationstack.com/dashboard
AVIATIONSTACK_API_KEY=

# ---- Optional ----
# OpenSky Network credentials. The free anonymous tier works for the smoke run
# (100 reqs / 24hr). Setting both raises the rate limit (~4000 reqs / day).
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Step 8 smoke targets. Defaults are BA117 LHR / AA1.
# Pick a flight you know is covered by the Aviationstack free tier today,
# and a flight number that has multiple legs/matches today for the ambiguous
# scenario.
# SMOKE_PERSONAL_FLIGHT=BA117
# SMOKE_PERSONAL_DEP=LHR
# SMOKE_AMBIGUOUS_FLIGHT=AA1
